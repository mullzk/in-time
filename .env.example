# Copy to .env for local development; never commit .env.

# required. A long, random string.
# this app stores no sensitive data and never uses this key, but django 
# requires the key to be set anyway
DJANGO_SECRET_KEY=change-me

# optional, default false. Dev only — MUST stay false in production.
DJANGO_DEBUG=true

# required. Comma-separated hostnames/domains the app may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# required. DB is needed to keep track of builds. 
# - sqlite:///relative/path
# - mysql://user:password@host:port/database
DATABASE_URL=sqlite:///data/in-time.sqlite3

# required. Persistent data dir, shared by app and build commands.
IN_TIME_DATA_DIR=./data

# optional, dev only, default empty. Referer the DEBUG tile proxy sends
# to swisstopo. The proxy 404s unless DEBUG, so prod never reads this: there
# nginx makes the request and sets the Referer from the app domain itself.
# IN_TIME_TILE_REFERER=

# optional, default empty = no reload. Command build_schedule runs
# after publishing a day, for a deployment whose server needs telling. Nginx
# follows the `current` symlink per request and needs nothing, so it stays unset.
# IN_TIME_RELOAD_COMMAND=
